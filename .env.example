# ════════════════════════════════════════════════════════════
#  FSB System — Variables d'environnement
#  INSTRUCTIONS : copier ce fichier en .env et remplir les valeurs
#  Ne JAMAIS commiter le fichier .env (il est dans .gitignore)
# ════════════════════════════════════════════════════════════

# ─── Django Core ────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changez-cette-valeur-en-production

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de données ────────────────────────────────────────
# Développement : sqlite:///./fsb_database.db
# Production    : postgresql://user:password@localhost:5432/fsb_db
DATABASE_URL=sqlite:///./fsb_database.db

# ─── Cache Redis ────────────────────────────────────────────
# Développement : laisser vide (pas de Redis)
# Production    : redis://localhost:6379/0
REDIS_URL=

# ─── API Keys IA ────────────────────────────────────────────
# Obtenir sur : https://console.groq.com/
GROQ_API_KEY=votre-cle-groq-ici

# ─── Email (optionnel) ──────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fsb.tn

# ─── Agent IA : fournisseur LLM et RAG ──────────────────────────────
# Fournisseur de génération : "groq" (production) ou "offline" (tests, sans réseau)
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Repli déterministe : si LLM_PROVIDER=groq mais que le SDK ou la clé
# manquent, basculer sur OfflineProvider au lieu de planter. Permet à
# une démo de rester utilisable sans secret (le RAG, le tool calling et
# le streaming SSE restent actifs ; seule la génération est dégradée).
# Mettre False en production réelle : mieux vaut une erreur explicite
# qu'un agent qui sert du déterministe sans que personne le remarque.
LLM_FALLBACK_OFFLINE=True

# Backend d'embeddings du RAG :
#   "tfidf"   → défaut, creux, aucun téléchargement, reproductible en CI
#   "spacy"   → vecteurs FR pré-entraînés (pip install spacy + modèle _md)
#   "hybrid"  → spaCy + TF-IDF concaténés : meilleur rappel sur les
#               paraphrases, MAIS perd le rejet hors-corpus (cf. A4)
#   "sentence-transformers" → MiniLM multilingue (télécharge les poids)
RAG_EMBEDDING_BACKEND=tfidf

# Corpus RAG : vide = corpus FSB par défaut. Pointer vers un dossier de
# fichiers .md d'un autre domaine pour réutiliser le moteur sans code.
RAG_CORPUS_DIR=

# ─── Données de démonstration ───────────────────────────────────────
# Mot de passe du compte `admin` créé par `python manage.py init_data`.
# En déploiement public, laisser la plateforme le générer plutôt que de
# publier un mot de passe connu (cf. render.yaml : generateValue).
DEMO_ADMIN_PASSWORD=admin123
